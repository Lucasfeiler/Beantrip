generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int        @id @default(autoincrement())
  email        String     @unique
  passwordHash String
  name         String
  location     String?
  bio          String?
  avatarUrl    String?
  isAdmin      Boolean    @default(false)
  isPremium    Boolean    @default(false)
  accountType  String     @default("customer")
  emailVerified Boolean   @default(false)
  gender             String?
  favoriteRoast      String?
  favoriteBrewMethod String?
  ageRange           String?
  coffeeSpend        String?
  referralSource     String?
  occupation         String?
  onboardingSeen     Boolean  @default(false)
  tourSeen           Boolean  @default(false)
  marketingConsent   Boolean  @default(false)
  createdAt    DateTime   @default(now())
  favorites    Favorite[]
  reviews      Review[]
  visits       Visit[]
  deviceTokens DeviceToken[]
  resetTokens  PasswordResetToken[]
  verificationTokens EmailVerificationToken[]
  ownedShops   Shop[]
  claims       ShopClaim[]
  photos       Photo[]
  submissions  Submission[]
  reviewFlags  ReviewFlag[]
  feedback     Feedback[]
}

model Shop {
  id           Int        @id @default(autoincrement())
  slug         String     @unique
  name         String
  city         String
  neighborhood String?
  address      String
  description  String?
  tags         Json       @default("[]")
  hours        Json?
  website      String?
  instagram    String?
  espressoMachine String?
  beanType     String?
  taste        String?
  originCountry String?
  image        String?
  images       Json?
  placeholder  Boolean    @default(false)
  rating       Float      @default(0)
  reviewCount  Int        @default(0)
  lat          Float?
  lng          Float?
  ownerId      Int?
  isPremium    Boolean    @default(false)
  beansInStock Boolean?
  createdAt    DateTime   @default(now())
  favorites    Favorite[]
  reviews      Review[]
  visits       Visit[]
  claims       ShopClaim[]
  userPhotos   Photo[]
  events       ShopEvent[]
  beans        Bean[]
  owner        User?      @relation(fields: [ownerId], references: [id], onDelete: SetNull)
}

model Bean {
  id        Int      @id @default(autoincrement())
  shopId    Int
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name      String
  roast     String?
  origin    String?
  createdAt DateTime @default(now())
}

model ShopEvent {
  id        Int      @id @default(autoincrement())
  shopId    Int
  type      String
  target    String?
  createdAt DateTime @default(now())
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, createdAt])
}

model Photo {
  id                Int       @id @default(autoincrement())
  userId            Int
  shopId            Int
  storageUrl        String
  moderationStatus  String    @default("pending")
  createdAt         DateTime  @default(now())
  reviewedAt        DateTime?
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop              Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
}

model ShopClaim {
  id         Int       @id @default(autoincrement())
  userId     Int
  shopId     Int
  message    String?
  status     String    @default("pending")
  createdAt  DateTime  @default(now())
  reviewedAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop       Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([userId, shopId])
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  shopId    Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([userId, shopId])
}

model Review {
  id           Int          @id @default(autoincrement())
  userId       Int
  shopId       Int
  rating       Int
  text         String
  ownerReply   String?
  ownerReplyAt DateTime?
  createdAt    DateTime     @default(now())
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop         Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  flags        ReviewFlag[]

  @@unique([userId, shopId])
}

model Visit {
  id        Int      @id @default(autoincrement())
  userId    Int
  shopId    Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([userId, shopId])
}

model DeviceToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailVerificationToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Submission {
  id           Int       @id @default(autoincrement())
  userId       Int?
  name         String
  city         String
  neighborhood String?
  address      String
  description  String?
  status       String    @default("pending")
  createdAt    DateTime  @default(now())
  reviewedAt   DateTime?
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Feedback {
  id         Int       @id @default(autoincrement())
  userId     Int?
  category   String
  rating     Int?
  message    String
  page       String?
  status     String    @default("new")
  adminNote  String?
  createdAt  DateTime  @default(now())
  reviewedAt DateTime?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Article {
  id          Int       @id @default(autoincrement())
  slug        String    @unique
  title       String
  coverImage  String?
  excerpt     String?
  externalUrl String?
  published   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  publishedAt DateTime?
}

model ReviewFlag {
  id         Int       @id @default(autoincrement())
  reviewId   Int?
  userId     Int
  reason     String?
  status     String    @default("pending")
  createdAt  DateTime  @default(now())
  reviewedAt DateTime?
  review     Review?   @relation(fields: [reviewId], references: [id], onDelete: SetNull)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, reviewId])
}

model Event {
  id          Int       @id @default(autoincrement())
  slug        String    @unique
  title       String
  coverImage  String?
  excerpt     String?
  location    String?
  eventDate   DateTime?
  ticketUrl   String?
  published   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  publishedAt DateTime?
}

model GearItem {
  id            Int       @id @default(autoincrement())
  slug          String    @unique
  title         String
  image         String?
  description   String?
  affiliateUrl  String
  published     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  publishedAt   DateTime?
}

model FeedSource {
  id            Int       @id @default(autoincrement())
  url           String    @unique
  name          String?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  lastFetchedAt DateTime?
  lastError     String?
}
